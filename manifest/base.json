{
  "manifest_version": 3,
  "name": "Git Patch Viewer",
  "version": "0.2.0",
  "description": "Renders raw git patches and diffs as a beautiful side-by-side view.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "Git Patch Viewer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*.patch*", "*://*/*.diff*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
